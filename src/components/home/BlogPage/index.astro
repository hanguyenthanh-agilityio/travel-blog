---
// Components
const { heroPost, popularPosts, trendingPosts, currentPage, totalPages } =
  Astro.props;
import {
  BlogGrid,
  BLogHero,
  SectionTitle,
  BlogCard,
  Paginator,
} from '@/components';

// Constants
import { POPULAR_TITLE, TRENDING_TITLE } from '@/constants/blog';
import { PAGE_PATH } from '@/constants/route';
---

<BLogHero {...heroPost} />
<SectionTitle {...POPULAR_TITLE} />

<div class="grid md:grid-cols-[1fr_1.4fr] gap-6 md:gap-4 lg:gap-10">
  <BlogCard
    {...popularPosts[0]}
    className="md:max-h-blog-sm lg:max-h-blog-md xl:max-h-blog-lg"
  />
  <div class="flex flex-col gap-6 md:gap-2 justify-between">
    <BlogCard {...popularPosts[1]} variant="horizontal" />
    <BlogCard {...popularPosts[2]} variant="horizontal" />
  </div>
</div>

<SectionTitle {...TRENDING_TITLE} />
<BlogGrid posts={trendingPosts} />

<div class="mt-10 flex justify-center">
  <Paginator
    currentPage={currentPage}
    totalPages={totalPages}
    basePath={PAGE_PATH}
    client:load
  />
</div>
