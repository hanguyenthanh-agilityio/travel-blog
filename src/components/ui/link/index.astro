---
interface LinkProps {
  href: string;
  label?: string;
  text?: string;
  classes?: string;
  external?: boolean;
  spanClass?: string;
}

const {
  href,
  label,
  text,
  classes,
  spanClass,
  external = false,
} = Astro.props as LinkProps;

const target = external ? '_blank' : '_self';
const rel = external ? 'noopener noreferrer' : undefined;
---

<a href={href} aria-label={label} class={classes} target={target} rel={rel}>
  <slot />
  {text && <span class={`ml-1 ${spanClass}`}>{text}</span>}
</a>
