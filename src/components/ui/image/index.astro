---
import { Image } from 'astro:assets';

interface Props {
  src: string;
  alt?: string;
  class?: string;
  width?: number;
  height?: number;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  format?: 'webp' | 'avif' | 'png' | 'jpeg';
  fit?: 'cover' | 'contain' | 'fill' | 'inside' | 'outside';
  quality?: number;
}

const {
  src,
  alt = '',
  class: className,
  width = 1920,
  height = 1080,
  sizes,
  loading = 'lazy',
  format = 'webp',
  fit = 'cover',
  quality = 80,
} = Astro.props;

const defaultSizes =
  sizes || '(max-width: 640px) 100vw, (max-width: 1024px) 100vw, 1920px';
---

<Image
  src={src}
  alt={alt}
  width={width}
  height={height}
  class={className}
  sizes={defaultSizes}
  loading={loading}
  decoding="async"
  fit={fit}
  quality={quality}
  format={format}
/>
