---
import { Image } from 'astro:assets';

// Components
import Link from '@/components/ui/link/index.astro';

// Libs
import { cn } from '@/lib/utils';

interface SocialItem {
  href: string;
  label: string;
  iconSrc: string;
  linkClassName?: string;
}

const { socials, containerClassName, linkClassName } = Astro.props as {
  socials: SocialItem[];
  containerClassName?: string;
  linkClassName?: string;
};
---

<div class={cn('flex mt-0 md:mt-4', containerClassName)}>
  {
    socials.map((s) => (
      <Link
        href={s.href}
        label={s.label}
        external
        classes={cn('flex items-center', linkClassName, s.linkClassName)}
      >
        <Image
          src={s.iconSrc}
          alt={s.label}
          width={48}
          height={48}
          class="h-6 w-6 object-contain"
          loading="lazy"
        />
      </Link>
    ))
  }
</div>
