---
import { Image } from 'astro:assets';

// Components
import SocialIcons from '@/components/common/SocialIcons/index.astro';
import ContactInfo from '@/components/common/ContactInfo/index.astro';
import Link from '@/components/ui/link/index.astro';

// Contents
import { socials, contactItems, bottomLinks } from '@/contents/blog';

const year = new Date().getFullYear();
---

<footer class="container mx-auto bg-white text-gray-800 px-4">
  <div
    class="py-10 flex flex-col lg:flex-row justify-between lg:items-center gap-10 lg:gap-0"
  >
    <!-- Logo and social icons -->
    <div class="pr-20 xl:pr-0">
      <Image
        src="/images/logo.svg"
        alt="logo image"
        width="250"
        height="50"
        format="avif"
        fit="cover"
        quality={80}
        class="pb-6"
      />
      <SocialIcons socials={socials} containerClassName="space-x-6" />
    </div>

    <!-- Contact info -->
    <div class="md:col-span-2 lg:col-span-3 2xl:pr-32">
      <ContactInfo items={contactItems} />
    </div>
  </div>

  <div
    class="flex flex-col lg:flex-row justify-between lg:items-center text-sm pt-0 pb-6 lg:py-10 text-secondary gap-4 lg:gap-0"
  >
    <p class="order-2 lg:order-1 font-medium">
      &copy; {year} Blog Template. All rights reserved.
    </p>

    <div
      class="order-1 lg:order-2 flex flex-col lg:flex-row space-y-3 lg:space-y-0 lg:space-x-6"
    >
      {bottomLinks.map((link) => <Link href={link.href} text={link.text} />)}
    </div>
  </div>
</footer>
