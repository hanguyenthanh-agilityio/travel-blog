---
import SocialIcons from '@/components/common/SocialIcons/index.astro';
import ContactInfo from '@/components/common/ContactInfo/index.astro';
import Link from '@/components/ui/link/index.astro';

import { socials, contactItems, bottomLinks } from '@/contents/blog';
import { Image } from 'astro:assets';
---

<footer class="container mx-auto bg-white text-gray-800 px-4">
  <div class="py-10 flex justify-between items-center">
    <!-- Logo and social icons -->
    <div class="pr-20 xl:pr-0">
      <Image
        src="/images/logo.svg"
        alt="logo image"
        width="250"
        height="50"
        format="avif"
        fit="cover"
        quality={80}
        class="pb-6"
      />
      <SocialIcons socials={socials} class="space-x-6" />

      <!-- Use For Blog detail -->
      <!-- <SocialIcons
        socials={socials}
        class="flex-col space-y-4"
        linkCustom="bg-[#f4f4f4] rounded-xl w-10 h-10 justify-center"
      /> -->
    </div>

    <!-- Contact info -->
    <div class="md:col-span-2 lg:col-span-3 2xl:pr-32">
      <ContactInfo items={contactItems} />
    </div>
  </div>

  <div class="flex justify-between item-center text-sm py-10 text-secondary">
    <p>
      &copy; <span id="copyright"></span> Blog Template. All rights reserved.
    </p>
    <div class="flex space-x-6">
      {bottomLinks.map((link) => <Link href={link.href} text={link.text} />)}
    </div>
  </div>
</footer>

<script>
  document.querySelector('#copyright')!.textContent = new Date()
    .getFullYear()
    .toString();
</script>
