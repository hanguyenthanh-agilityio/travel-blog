---
import SocialIcons from '@/components/common/SocialIcons/index.astro';
import { socials } from '@/contents/socials';
import { Image } from 'astro:assets';
---

<footer class="border-t bg-white text-gray-800">
  <div
    class="mx-auto max-w-6xl px-6 py-10 grid gap-10 md:grid-cols-2 lg:grid-cols-4"
  >
    <div>
      <Image
        src="/images/logo.svg"
        alt="logo image"
        width="250"
        height="50"
        format="avif"
        fit="cover"
        quality={80}
        class="pb-6"
      />
      <SocialIcons socials={socials} class="space-x-6" />

      <!-- Use For Blog detail -->
      <!-- <SocialIcons
        socials={socials}
        class="flex-col space-y-4"
        linkCustom="bg-[#f4f4f4] rounded-xl w-10 h-10 justify-center"
      /> -->
    </div>
  </div>
</footer>
