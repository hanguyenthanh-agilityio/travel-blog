---
// Components
import { Navigation, SheetMenu } from '@/components';
import Image from '@/components/ui/image/index.astro';
import Link from '@/components/ui/link';

// Constants
import { HOME_PAGE } from '@/constants/route';
---

<header class="w-full bg-white shadow-sm sticky top-0 z-50">
  <div class="container mx-auto px-4 py-4">
    <div class="flex items-center justify-between">
      <!-- Logo/Brand -->
      <div class="flex items-center">
        <Link
          href={HOME_PAGE}
          class="focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 rounded-md"
        >
          <Image
            src="/images/logo.svg"
            alt="Blog Template - Home"
            width={194}
            height={40}
            format="webp"
            fit="contain"
            quality={90}
            loading="eager"
            class="h-8 w-auto md:h-10 transition-transform duration-200 hover:scale-105"
          />
        </Link>
      </div>

      <!-- Desktop Navigation -->
      <nav class="hidden md:block" aria-label="Main navigation">
        <Navigation />
      </nav>

      <!-- Mobile Menu -->
      <div class="md:hidden">
        <SheetMenu client:load />
      </div>
    </div>
  </div>
</header>
