---
// Components
import NavDropdownMenu from '../NavDropdownMenu';
import Link from '@/components/ui/link/index.astro';

const menu = [
  { href: '/', text: 'Home' },
  { href: '/blog', text: 'Blog' },
  { href: '/post/example', text: 'Single Post' },
];

const otherPages = [
  { href: '/about', text: 'About' },
  { href: '/contact', text: 'Contact' },
];
---

<div class="flex items-center gap-6">
  <nav class="flex items-center space-x-6">
    {
      menu.map((item) => (
        <Link
          href={item.href}
          text={item.text}
          class="text-sm hover:text-gray-600"
        />
      ))
    }
  </nav>
  <NavDropdownMenu client:idle label="Other Pages" items={otherPages} />
</div>
