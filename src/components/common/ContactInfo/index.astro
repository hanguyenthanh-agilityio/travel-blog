---
const { items } = Astro.props as {
  items: { label: string; value: string }[];
};
---

<div class="grid grid-col-1 gap-6 lg:gap-10 lg:grid-cols-3 text-sm">
  {
    items.map((item) => (
      <div>
        <p class="font-semibold">{item.label}</p>
        <p class="text-gray-600">{item.value}</p>
      </div>
    ))
  }
</div>
