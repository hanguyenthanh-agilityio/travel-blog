---
// Layouts
import BlogLayout from '@/layouts/BlogLayout.astro';

// Components
import { AuthorCard, SocialIcons, LazyImage } from '@/components';

// Contents
import { socials } from '@/contents/blog';

// Libs
import { fetchPostById, fetchPosts } from '@/lib/api';
import type { Post } from '@/lib/schema';
import { slugify } from '@/lib/utils';

export async function getStaticPaths() {
  const posts = await fetchPosts();

  return posts.map((post) => ({
    params: { id: post.id },
  }));
}

const { id } = Astro.params;
const post: Post | null = await fetchPostById(id);
if (!post) throw new Error(`Post with id ${id} not found`);
---

<BlogLayout>
  <article class="max-w-3xl mx-auto py-8">
    <header class="md:px-8">
      <AuthorCard
        {...post.author}
        isBlogDetail={true}
        isRole={true}
        classAvatar="w-14 h-14"
        classContainer="!justify-center pb-4"
        className="flex flex-col gap-1 justify-center items-center"
        client:load
      />
      <h1 class="text-xl md:text-3xl lg:text-4xl font-bold mb-4 text-center">
        {post.title}
      </h1>

      <p
        class="text-center text-sm text-primary mt-2 pb-5 border-b border-line"
      >
        {post.author.date}
      </p>
    </header>
    <div class="lg:relative">
      <!-- Social Icons -->
      <aside
        class="lg:absolute lg:right-[-100px] pt-5"
        aria-label="Share on social networks"
      >
        <SocialIcons
          socials={socials}
          containerClassName="justify-center lg:flex-col gap-3 md:gap-4"
          linkClassName="bg-[#f4f4f4] rounded-xl p-2"
        />
      </aside>

      <p class="pt-5 text-primary text-base md:px-8">
        {post.excerpt}
      </p>

      <LazyImage
        src={post.image}
        alt={post.title}
        class="rounded-xl my-6 w-full h-[400px] md:h-auto"
        loading="lazy"
        decoding="async"
      />

      <div class="prose lg:prose-lg md:px-8">
        <div class="border-l-2 border-line">
          <p class="pl-4 text-primary text-base">{post.content.intro}</p>
        </div>

        {
          post.content?.sections?.map(
            (section: { country: string; items: string[] }) => {
              const headingId = slugify(section.country);
              return (
                <section aria-labelledby={headingId}>
                  <h2 id={headingId} class="text-lg font-semibold mt-6">
                    {section.country}
                  </h2>
                  <ul class="list-disc ml-6 text-primary text-base">
                    {section.items.map((item: string) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </section>
              );
            },
          )
        }

        <p class="mt-8 font-medium">{post.content.conclusion}</p>
      </div>
    </div>
  </article>
</BlogLayout>
