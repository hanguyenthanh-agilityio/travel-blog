---
// Layouts
import BlogLayout from '@/layouts/BlogLayout.astro';

// Components
import { BlogGrid, BLogHero, SectionTitle, BlogCard } from '@/components';
import Paginator from '@/components/common/Paginator';

// Libs
import { fetchPosts, getPopularPosts, getTrendingPosts } from '@/lib/api';

const { page } = Astro.params;
const currentPage = Number(page) || 1;
const POSTS_PER_PAGE = 6;

// Fetch data
const posts = await fetchPosts();
const heroPost = posts[0];
const popularPosts = await getPopularPosts();

// All trending posts
const allTrendingPosts = await getTrendingPosts();
const totalPages = Math.ceil(allTrendingPosts.length / POSTS_PER_PAGE);

// Slice for current page
const trendingPosts = allTrendingPosts.slice(
  (currentPage - 1) * POSTS_PER_PAGE,
  currentPage * POSTS_PER_PAGE,
);

const popularTitle = {
  title: 'Popular Post',
  subTitle: 'Ideas, trends, and inspiration for a brighter future',
};

const trendingTitle = {
  title: 'Trending Post',
  subTitle: 'Discover how innovation and creativity drive meaningful change',
};

export async function getStaticPaths() {
  const allTrendingPosts = await getTrendingPosts();
  const POSTS_PER_PAGE = 6;
  const totalPages = Math.ceil(allTrendingPosts.length / POSTS_PER_PAGE);

  return Array.from({ length: totalPages }).map((_, i) => ({
    params: { page: String(i + 1) },
  }));
}
---

<BlogLayout>
  <BLogHero {...heroPost} />
  <SectionTitle {...popularTitle} />

  <div class="grid md:grid-cols-[1fr_1.4fr] gap-6 md:gap-4 lg:gap-10">
    <BlogCard
      {...popularPosts[0]}
      className="md:max-h-[200px] lg:max-h-[230px] xl:max-h-[340px]"
    />
    <div class="flex flex-col gap-6 md:gap-2 justify-between">
      <BlogCard {...popularPosts[1]} variant="horizontal" />
      <BlogCard {...popularPosts[2]} variant="horizontal" />
    </div>
  </div>

  <SectionTitle {...trendingTitle} />
  <BlogGrid posts={trendingPosts} />

  <div class="mt-10 flex justify-center">
    <Paginator
      currentPage={currentPage}
      totalPages={totalPages}
      basePath="/page"
      client:load
    />
  </div>
</BlogLayout>
