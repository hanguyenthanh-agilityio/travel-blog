---
import { PortableText } from '@/components';
const { heading } = Astro.props;
const hasHeading = heading && Array.isArray(heading) && heading.length > 0;
---

{hasHeading ? (
  <Fragment>
    <div class="text-center text-primary my-8">
      <PortableText portableText={heading} />
    </div>
  </Fragment>
) : null}
