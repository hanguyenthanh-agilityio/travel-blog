---
// sections
import { BlogCard } from '@/sections';

// Types
import type { Blog } from '@/types/blog';

interface BlogCardProps {
  posts: Blog[];
  column?: number | string;
}
const { posts, column = 3 } = Astro.props as BlogCardProps;
---

<div class={`grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-${column} gap-10`}>
  {
    posts.map((post) => (
      <BlogCard {...post} className="h-blog-sm md:h-blog-md xl:h-blog-lg" />
    ))
  }
</div>
