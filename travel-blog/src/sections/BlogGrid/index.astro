---
import { BlogCard } from '@/sections';
import type { Blog } from '@/types/blog';

interface Props {
  posts: Blog[];
  column?: number | string;
  className?: string;
}

const { posts, column = 3, className = '' } = Astro.props;

const columnClass =
  column === 1
    ? 'lg:grid-cols-1'
    : column === 2
    ? 'lg:grid-cols-2'
    : column === 4
    ? 'lg:grid-cols-4'
    : 'lg:grid-cols-3';
---

<div class={`grid grid-cols-1 sm:grid-cols-2 ${columnClass} gap-10 ${className}`}>
  {posts.map((post) => (
    <BlogCard
      {...post}
      variant={(post.variant as 'default' | 'horizontal') || 'default'}
      className="h-blog-sm md:h-blog-md xl:h-blog-lg"
    />
  ))}
</div>
