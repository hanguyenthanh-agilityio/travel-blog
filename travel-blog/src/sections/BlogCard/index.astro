---
// Components
import { Link, SanityImage, Heading } from '@/components';

// Sections
import { AuthorCard } from '@/sections';

// Utils
import { cn } from '@/lib/utils';

interface Author {
  name: string;
  role?: string;
  avatar?: string;
  date?: string | Date;
}

interface Props {
  slug?: string | { current: string };
  title: string;
  image?: string | { asset?: { _ref?: string; url?: string } };
  author?: Author | null;
  variant?: 'default' | 'horizontal';
  className?: string;
  titleClassName?: string;
}

const {
  slug,
  title,
  image,
  author,
  variant = 'default',
  className = '',
  titleClassName = '',
} = Astro.props;

const postSlug = typeof slug === 'string' ? slug : slug?.current || '';

const isHorizontal = variant === 'horizontal';
---

<Link href={`/posts/${postSlug}`} aria-label={title}>
  <div
    data-testid="blog-card"
    class={cn(
      'h-auto overflow-hidden rounded-xl bg-transparent transition-transform duration-300 ease-in-out hover:shadow-lg hover:-translate-y-1 hover:scale-[1.01]',
      isHorizontal ? 'flex flex-col md:flex-row gap-4' : 'flex flex-col',
    )}
  >
    <!-- Image -->
    {
      image && (
        <SanityImage
          node={image}
          alt={title}
          className={cn(
            'object-cover rounded-xl w-full',
            isHorizontal && 'md:w-1/2 max-h-blog-md',
            className,
          )}
          loading="lazy"
          client:idle
        />
      )
    }

    <!-- Content -->
    <div
      class={cn(
        'flex flex-col justify-between px-2 gap-8',
        isHorizontal ? 'flex-1 py-4 flex flex-col justify-between' : 'py-4',
        titleClassName,
      )}
    >
      <Heading>{title}</Heading>

      {
        author && (
          <AuthorCard
            {...author}
            classAvatar="w-10 h-10"
            role="true"
            client:visible
          />
        )
      }
    </div>
  </div>
</Link>
