---
import { PortableText } from '@/components';
import { AuthorCard } from '@/sections';

interface Props {
  title: string | undefined;
  author?: {
    name: string;
    role?: string;
    avatar?: string | { asset?: { url?: string } };
    date?: string | Date;
  } | null;
}

const { title, author } = Astro.props;
---

<header class="md:px-8 text-center">
  {
    author && (
      <AuthorCard
        {...author}
        isBlogDetail={true}
        isRole={true}
        classAvatar="w-14 h-14"
        classContainer="!justify-center pb-4"
        className="flex flex-col gap-1 justify-center items-center"
        client:idle
      />
    )
  }

  <PortableText portableText={title} />

  {
    author?.date && (
      <p class="text-sm text-primary mt-2 pb-5 border-b border-line">
        {author.date}
      </p>
    )
  }
</header>
