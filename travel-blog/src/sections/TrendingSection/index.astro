---
import { SectionHeading, TrendingPosts } from '@/sections';

const { heading, posts, postsPerPage = 6 } = Astro.props;
---

<section
  id="trending"
  class="container mx-auto flex flex-col mb-20"
  aria-label="Trending blog posts"
>
  <SectionHeading heading={heading} />
  <TrendingPosts posts={posts} postsPerPage={postsPerPage} client:load />
</section>
