---
import { BlogCard } from '@/sections';

const { posts } = Astro.props;
---
<>
  <div class="grid md:grid-cols-[1fr_1.4fr] gap-6 md:gap-4 lg:gap-10">
    <!-- First (featured) post -->
    <BlogCard
      {...posts[0]}
      className="md:max-h-blog-sm lg:max-h-blog-md xl:max-h-blog-lg"
      titleClassName="h-full"
    />

    <!-- Remaining posts -->
    <div class="flex flex-col gap-6 md:gap-2 justify-between">
      {posts.slice(1, 3).map((post:any) => (
        <BlogCard {...post} variant="horizontal"/>
      ))}
    </div>
  </div>
</>
