---
// Components
import { SocialIcons, ContactInfo, Logo, FooterLinks } from '@/components';

// Contents
import { contactItems, bottomLinks } from '@/mockData/blog';

// Constants
import { HOME_PAGE } from '@/constants/route';
import { getSocials } from '@/lib/api';


const  socials  = await getSocials();

const year = new Date().getFullYear();

---

<footer class="container mx-auto bg-white text-gray-800 px-4">
  <!-- Main Footer Content -->
  <div
    class="py-10 flex flex-col lg:flex-row justify-between lg:items-center gap-10 lg:gap-0"
  >
    <!-- Brand Section -->
    <div class="pr-20 xl:pr-0">
      <Logo href={HOME_PAGE} width={280} height={100} classes="pb-3 md:pb-5" />
      <SocialIcons socials={socials} />
    </div>

    <!-- Contact Information -->
    <div class="md:col-span-2 lg:col-span-3 2xl:pr-32">
      <ContactInfo items={contactItems} />
    </div>
  </div>

  <!-- Footer Bottom -->
  <div
    class="flex flex-col lg:flex-row justify-between lg:items-center text-sm pt-0 pb-6 lg:py-10 text-secondary gap-4 lg:gap-0"
  >
    <!-- Copyright -->
    <p class="order-2 lg:order-1 font-medium">
      &copy; {year} Blog Template. All rights reserved.
    </p>

    <!-- Bottom Links -->
    <FooterLinks bottomLinks={bottomLinks} />
  </div>
</footer>
