---
import { NavDropdownMenu, Link } from '@/components';

interface Props {
  items?: { text?: string; href?: string }[];
  otherPages?: { text?: string; href?: string }[];
}

const { items = [], otherPages = [] } = Astro.props as Props;
---

<nav
  class="flex items-center gap-6"
  aria-label="Main site navigation"
  role="navigation"
>
  <!-- Primary Links -->
  <ul class="flex items-center space-x-6">
    {items.map((item) => (
      <li>
        <Link
          href={item.href ?? '#'}
          text={item.text}
          aria-label={`Navigate to ${item.text} page`}
          classes="text-base text-gray-700 hover:text-accent transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 rounded-md px-2 py-1"
        />
      </li>
    ))}
  </ul>

  <!-- Secondary Dropdown -->
  <div class="flex-shrink-0">
    <NavDropdownMenu
      client:idle
      label="Other Pages"
      items={otherPages.filter((p) => p?.href && p?.text) as { href: string; text: string }[]}
      aria-label="Other pages dropdown menu"
    />
  </div>
</nav>
