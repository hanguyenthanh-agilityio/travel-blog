---
import { NavDropdownMenu, Link } from '@/components';

interface SanityLinkItem {
  text?: string;
  href?: string;
}

interface Props {
  menuItems?: SanityLinkItem[];
  otherPages?: SanityLinkItem[];
}

const { menuItems  = [], otherPages = [] } = Astro.props as Props;
---

<nav
  class="flex items-center gap-6"
  aria-label="Main site navigation"
  role="navigation"
>
  <!-- Primary Links -->
  <ul class="flex items-center space-x-6">
    {
      menuItems.length > 0 && (
        <ul class="flex items-center space-x-6">
          {menuItems.map((item) =>
            item?.text && item?.href ? (
              <li>
                <Link
                  href={item.href}
                  text={item.text}
                  aria-label={`Navigate to ${item.text} page`}
                  classes="text-base text-gray-700 hover:text-accent transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 rounded-md px-2 py-1"
                />
              </li>
            ) : null
          )}
        </ul>
      )
    }
  </ul>

  <!-- Secondary Dropdown -->
  {
    otherPages.length > 0 && (
      <div class="flex-shrink-0">
        <NavDropdownMenu
          client:idle
          label="Other Pages"
          items={
            otherPages.filter(
              (p): p is { href: string; text: string } =>
                Boolean(p?.href && p?.text)
            )
          }
          aria-label="Other pages dropdown menu"
        />
      </div>
    )
  }
</nav>
