---
import { Typography } from '..';

interface Props {
  items?: { label: string; value: string }[];
}

const { items = [] } = Astro.props;
---

<div class="grid grid-col-1 gap-6 lg:gap-10 lg:grid-cols-3">
  {
    items.map((item) => (
      <div class="flex flex-col gap-1">
        <Typography as="p" size="sm" className="font-semibold">
          {item.label}
        </Typography>
        <Typography as="p" size="sm" className="text-secondary font-normal">
          {item.value}
        </Typography>
      </div>
    ))
  }
</div>
