---
interface Props {
  href: string;
  label?: string;
  text?: string;
  classes?: string;
  external?: boolean;
  spanClass?: string;
}

const { href, label, text, classes = '', external = false } = Astro.props;

const target = external ? '_blank' : '_self';
const rel = external ? 'noopener noreferrer' : undefined;
const ariaLabel = label || text || '';
---

<a href={href} aria-label={ariaLabel} class={classes} target={target} rel={rel}>
  <slot />
</a>
