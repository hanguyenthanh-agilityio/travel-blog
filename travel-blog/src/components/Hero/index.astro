---
// Components
import { Link, SanityImage, Heading } from '@/components';

// Sections
import { AuthorCard } from '@/sections';

interface HeroProps {
  title: string;
  image?: any;
  author?: any;
  slug: { current: string };
}

const { title, image, author, slug } = Astro.props as HeroProps;

const safeTitle = title || '';
const parts = safeTitle.split(':');
---

<section
  class="relative w-full h-blog-lg rounded-2xl overflow-hidden"
  aria-labelledby="hero-title"
>
  <Link
    href={`/posts/${slug?.current}`}
    classes="block focus:outline-none focus:ring-4 focus:ring-primary/50 rounded-2xl"
  >
    <!-- Sanity Image Integration -->
    <SanityImage
      node={image}
      className="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      width={1200}
      height={800}
      priority={true}
      client:idle
    />

    <!-- Overlay Gradient -->
    <div
      class="absolute inset-0 bg-gradient-to-b from-[#2980B9]/0 to-[#2980B9]"
    >
    </div>

    <!-- Title Section -->
    <div
      class="absolute top-4 md:top-8 left-3 md:left-10 right-3 md:right-10 text-white"
    >
      <Heading size="lg" as="h1">
        {parts[0]}:
        <br />
        {parts[1]}
      </Heading>
    </div>

    <!-- Author Info -->
    <div
      class="absolute bottom-4 md:bottom-8 left-3 md:left-10 right-3 md:right-10 text-white"
    >
      <AuthorCard
        {...author}
        classAvatar="w-10 h-10"
        isRole="true"
        dark
        client:visible
      />
    </div>
  </Link>
</section>
