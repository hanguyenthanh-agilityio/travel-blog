---
import { PortableText as PortableTextInternal } from 'astro-portabletext';
import { SanityImage } from '@/components';
import { BlockH2, BlockH3, BlockNormal } from '@/components/Blocks';
import {MarkStrong, MarkLink} from "@/components/Marks"

const { portableText } = Astro.props;

const components = {
  type: {
    image: SanityImage,
  },
  block: {
    h2: BlockH2,
    h3: BlockH3,
    normal: BlockNormal
  },
  masks: {
    strong: MarkStrong,
    link: MarkLink
  }
};
---

<div class="prose prose-neutral lg:prose-lg max-w-none">
  <PortableTextInternal value={portableText} components={components} />
</div>
