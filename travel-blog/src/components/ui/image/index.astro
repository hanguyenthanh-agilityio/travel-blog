---
import {urlForImage} from '@/sanity/url-for-image'
import {Image} from 'astro:assets'

interface Props {
  src: any
  alt?: string
  class?: string
  width?: number
  height?: number
  sizes?: string
  loading?: 'lazy' | 'eager'
  format?: 'webp' | 'avif' | 'png' | 'jpeg'
  fit?: 'clip' | 'crop' | 'fill' | 'fillmax' | 'max' | 'scale' | 'min'
  quality?: number
}

const {
  src,
  alt = '',
  class: className,
  width = 1920,
  height = 1080,
  sizes,
  loading = 'lazy',
  format = 'webp',
  fit = 'fill',
  quality = 80,
} = Astro.props

const defaultSizes = sizes || '(max-width: 640px) 100vw, (max-width: 1024px) 100vw, 1920px'

// Build Sanity image URL with optimization
const imageUrl = urlForImage(src).width(width).height(height).fit(fit).quality(quality).url()
---

<Image
  src={imageUrl}
  alt={alt}
  width={width}
  height={height}
  class={className}
  sizes={defaultSizes}
  loading={loading}
  decoding="async"
  fit={fit}
  quality={quality}
  format={format}
/>
