---
import {urlForImage} from '@/sanity/url-for-image'
// import type {SanityAsset} from '@sanity/image-url/lib/types/types'

interface Props {
  src: any
  alt?: string
  class?: string
  width?: number
  height?: number
  loading?: 'lazy' | 'eager'
  fetchpriority?: 'high' | 'low' | 'auto'
  quality?: number
}

const {
  src,
  alt = '',
  class: className = '',
  width = 1200,
  height = 800,
  loading = 'lazy',
  fetchpriority = 'auto',
  quality = 80,
} = Astro.props

const breakpoints = [320, 640, 960, 1280, 1920]

// Sanity URL builder responsive (auto format, crop, fit, quality)
const srcSetWebp = breakpoints
  .map(
    (w) =>
      `${urlForImage(src)
        .width(w)
        .height(Math.round((height / width) * w))
        .fit('crop')
        .auto('format')
        .quality(quality)
        .url()} ${w}w`
  )
  .join(', ')

const srcSetFallback = breakpoints
  .map(
    (w) =>
      `${urlForImage(src)
        .width(w)
        .height(Math.round((height / width) * w))
        .fit('crop')
        .format('jpg')
        .quality(quality)
        .url()} ${w}w`
  )
  .join(', ')

const defaultSizes = '(max-width: 640px) 100vw, (max-width: 1024px) 80vw, 1200px'

const fallbackSrc = urlForImage(src)
  .width(640)
  .height(Math.round((height / width) * 640))
  .fit('crop')
  .auto('format')
  .quality(quality)
  .url()
---

<picture>
  <source type="image/webp" srcset={srcSetWebp} sizes={defaultSizes} />
  <source type="image/jpeg" srcset={srcSetFallback} sizes={defaultSizes} />
  <img
    src={fallbackSrc}
    alt={alt}
    class={className}
    width={width}
    height={height}
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
  />
</picture>
