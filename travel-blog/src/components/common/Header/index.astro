---
// Components
import { Navigation, SheetMenu, Logo } from '@/components';

// Constants
import { HOME_PAGE } from '@/constants/route';
---

<header class="w-full bg-white shadow-sm sticky top-0 z-50">
  <div class="container mx-auto px-4 py-4">
    <div class="flex items-center justify-between">
      <!-- Logo/Brand -->
      <div class="flex items-center">
        <Logo href={HOME_PAGE} className="text-primary" />
      </div>

      <!-- Desktop Navigation -->
      <nav class="hidden md:block" aria-label="Main navigation">
        <Navigation />
      </nav>

      <!-- Mobile Menu -->
      <div class="md:hidden">
        <SheetMenu client:load />
      </div>
    </div>
  </div>
</header>
