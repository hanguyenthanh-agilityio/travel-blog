---
// Components
import {Link} from '@/components';

import { cn } from '@/lib/utils';

import { LogoIcon } from '@/icons';

interface LogoProps {
  href: string;
  width: number;
  height: number;
  classes: string;
  ariaLabel?: string;
}

const { href, width, height, classes, ariaLabel='Go to homepage' } = Astro.props as LogoProps;
---

<Link
  href={href}
  aria-label={ariaLabel}
  classes="focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 rounded-md"
>
  <LogoIcon
    role="img"
    width={width}
    height={height}
    aria-hidden="true"
    format="webp"
    className={cn('transition-transform duration-200 hover:scale-105', classes)}
  />
  <span class="sr-only">Blog Template Home</span>
</Link>
