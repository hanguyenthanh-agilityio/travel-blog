---
// Components
import {Link} from '@/components';

import { cn } from '@/lib/utils';

import { LogoIcon } from '@/icons';

interface LogoProps {
  href: string;
  width: number;
  height: number;
  classes: string;
}

const { href, width, height, classes } = Astro.props as LogoProps;
---

<Link
  href={href}
  classes="focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 rounded-md"
>
  <LogoIcon
    width={width}
    height={height}
    format="webp"
    className={cn('transition-transform duration-200 hover:scale-105', classes)}
  />
</Link>
