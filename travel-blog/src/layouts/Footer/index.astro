---
import {
  SocialIcons,
  ContactInfo,
  SanityImage,
  PortableText,
  Link,
} from '@/components';
import FooterLinks from './FooterLinks/index.astro';
import { HOME_PAGE } from '@/constants/route';

const {
  logo,
  contactItems = [],
  socials = [],
  bottomLinks = [],
  copyright,
} = Astro.props;
---

<footer class="container mx-auto bg-white text-gray-800 px-4">
  <div
    class="py-10 flex flex-col lg:flex-row justify-between lg:items-center gap-10 lg:gap-0"
  >
    <!-- Brand Section -->
    <div class="pr-20 xl:pr-0">
      <Link
        href={logo?.link || HOME_PAGE}
        aria-label="Go to homepage"
        text={logo ? 'Home' : undefined}
      >
        {
          logo?.image?.asset?.url ? (
            <SanityImage
              node={logo.image.asset.url}
              alt="Blog logo"
              width={280}
              height={100}
              className="object-contain transition-transform duration-200 hover:scale-105"
            />
          ) : (
            <span
              class="w-28 h-10 bg-gray-200"
              role="img"
              aria-label="Blog logo"
            />
          )
        }
      </Link>

      {socials.length > 0 && <SocialIcons socials={socials} />}
    </div>

    <!-- Contact Information -->
    <div class="md:col-span-2 lg:col-span-3 2xl:pr-32">
      {contactItems.length > 0 && <ContactInfo items={contactItems} />}
    </div>
  </div>

  <!-- Footer Bottom -->
  <div
    class="flex flex-col lg:flex-row justify-between lg:items-center text-sm pt-0 pb-6 lg:py-10 text-secondary gap-4 lg:gap-0"
  >
    <!-- Copyright -->
    {copyright && <PortableText portableText={copyright} />}

    <!-- Bottom Links -->
    {bottomLinks.length > 0 && <FooterLinks bottomLinks={bottomLinks} />}
  </div>
</footer>
