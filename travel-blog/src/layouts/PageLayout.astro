---
import { VisualEditing } from "@sanity/astro/visual-editing";

// Layouts
import SeoHead from './SeoHead.astro';
import Header from './Header/index.astro'
import Footer from './Footer/index.astro'


// Styles
import '../styles/globals.css';
import { loadQuery } from "@/sanity/load-query";
import type { FooterType, HeaderType } from "@/types/home";
import { headerQuery } from "@/queries/header";
import { footerQuery } from "@/queries/footer";


const seo = Astro.props.seo || {};

const {
  title = seo.title || 'My Astro Blog',
  description = seo.description || 'My musings about the Astro framework',
  image = seo.image,
  url = seo.url,
  noindex = seo.noindex ?? false,
} = Astro.props;

const visualEditingEnabled =
  import.meta.env.PUBLIC_SANITY_VISUAL_EDITING_ENABLED === "true";

// --- Header data
let headerData: HeaderType | null = null;
try {
  const { data } = await loadQuery<HeaderType>({ query: headerQuery });
  headerData = data;
} catch {
  console.error('Failed to fetch header data');
}

// --- Footer data
let footerData: FooterType | null = null;
try {
  const { data } = await loadQuery<FooterType>({ query: footerQuery });
  footerData = data;
} catch {
  console.error('Failed to fetch footer data');
}

const { logo, menuItems = [], otherPages = [] } = headerData ?? {};
const { contactItems = [], socials = [] } = footerData ?? {};

console.log(socials);

---

<html lang="en">
  <SeoHead {title} {description} {image} {url} {noindex} />
  <body>
    <Header {logo} {menuItems} {otherPages} />
    <main class="flex-1 container mx-auto px-4 py-8 pt-[80px]">
      <slot />
    </main>
    <Footer {logo} {contactItems} {socials} />

    <VisualEditing enabled={visualEditingEnabled} />
  </body>
</html>