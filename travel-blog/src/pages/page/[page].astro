---
// Layouts
import PageLayout from '@/layouts/PageLayout.astro';

// Libs
import { getPage } from '@/lib/getPage';

// Sections
import { BlogPage } from '@/sections';

const rawPage = Number(Astro.params.page) || 1;

const { heroPost, popularPosts, trendingPosts, currentPage, totalPages } =
  await getPage(rawPage);

// Static paths
import { POSTS_PER_PAGE } from '@/constants/blog';
import { getTrendingPosts } from '@/lib/api';

export async function getStaticPaths() {
  const allTrendingPosts = await getTrendingPosts();
  const totalPages = Math.max(
    1,
    Math.ceil(allTrendingPosts.length / POSTS_PER_PAGE),
  );

  return Array.from({ length: totalPages - 1 }).map((_, i) => ({
    params: { page: String(i + 2) },
  }));
}
---

<PageLayout>
  <BlogPage
    heroPost={heroPost}
    popularPosts={popularPosts}
    trendingPosts={trendingPosts}
    currentPage={currentPage}
    totalPages={totalPages}
  />
</PageLayout>
