---
// Layouts
import PageLayout from '@/layouts/PageLayout.astro';

// Components
import {Link} from '@/components';

// Constants
import { HOME_PAGE } from '@/constants';

const path = Astro.url.pathname;
---

<PageLayout title="Page Not Found" description="Oops! Page not found">
  <section
    class="min-h-[70vh] flex flex-col items-center justify-center text-center px-4"
  >
    <!-- Big 404 number -->
    <h1 class="text-xl md:text-3xl font-bold text-gray-600 leading-none">
      404
    </h1>

    <!-- Message -->
    <p class="text-xl md:text-2xl font-semibold text-gray-700 mt-4">
      Oops! We can’t find that page
    </p>
    <p class="text-gray-500 mt-2 max-w-md">
      {
        `The page at "${path}" might have been moved, deleted, or never existed.`
      }
    </p>

    <!-- Back home button -->
    <div class="mt-6">
      <Link
        href={HOME_PAGE}
        text="← Back to Home"
        spanClass="text-blue-600 font-medium hover:underline transition"
      />
    </div>
  </section>
</PageLayout>
