---
import { Hero } from '@/components';
import PageLayout from '@/layouts/PageLayout.astro';
import { homePageQuery } from '@/queries/homePage';

// Sanity utils
import { loadQuery } from '@/sanity/load-query';
import { PopularPosts, TrendingPosts } from '@/sections';
import type { HomePageType } from '@/types/home';

let homePage: HomePageType | null = null;

try {
  const { data } = await loadQuery<HomePageType>({
    query: homePageQuery,
  });
  homePage = data;
} catch {
  throw new Error('Internal Server Error');
}

if (!homePage) {
  throw new Error('Not Found');
}

const { heroPost, popularPosts, trendingPosts } = homePage;
console.log(popularPosts);

---

<PageLayout>
  <Hero {...heroPost} />

  <PopularPosts posts={popularPosts} />

  <TrendingPosts posts={trendingPosts} postsPerPage={3} client:load />
</PageLayout>
