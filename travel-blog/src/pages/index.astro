---
// Layouts
import PageLayout from '@/layouts/PageLayout.astro';

// Components
import { Hero } from '@/components';

// Sections
import { PopularPosts, TrendingPosts } from '@/sections';

// Types
import type { HomePageType } from '@/types/home';

// Queries
import { homePageQuery } from '@/queries/homePage';

// Sanity
import { loadQuery } from '@/sanity/load-query';

import { URL } from 'node:url';

const url = new URL(Astro.request.url);
const currentPage = Number(url.searchParams.get('page')) || 1;
const POSTS_PER_PAGE = 6;

let homePage: HomePageType | null = null;

try {
  const { data } = await loadQuery<HomePageType>({ query: homePageQuery });
  homePage = data;
} catch {
  throw new Error('Internal Server Error');
}

if (!homePage) throw new Error('Not Found');

const { heroPost, popularPosts, trendingPosts } = homePage;

// Slice trending posts for pagination
const totalPosts = trendingPosts.posts.length;
const totalPages = Math.ceil(totalPosts / POSTS_PER_PAGE);
const paginatedPosts = trendingPosts.posts.slice(
  (currentPage - 1) * POSTS_PER_PAGE,
  currentPage * POSTS_PER_PAGE,
);
---

<PageLayout>
  <Hero {...heroPost} />

  <PopularPosts heading={popularPosts.heading} posts={popularPosts.posts} />

  <TrendingPosts
    heading={trendingPosts.heading}
    posts={paginatedPosts}
    currentPage={currentPage}
    totalPages={totalPages}
  />
</PageLayout>
