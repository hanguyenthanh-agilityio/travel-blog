---
import PageLayout from '@/layouts/PageLayout.astro';

// Components
import { Hero } from '@/components';
import { POPULAR_TITLE } from '@/constants';

// Sections
import { BlogCard, HeadingBlock, TrendingPosts } from '@/sections';

// Libs
import { getPage } from '@/lib/getPage';

const { heroPost, popularPosts, trendingPosts } =
  await getPage();
---

<PageLayout>
  <!-- HERO SECTION -->
  <section class="mb-12 md:mb-20">
    <Hero {...heroPost} />
  </section>

  <!-- POPULAR POSTS -->
  <section class="container mx-auto mb-16 md:mb-24">
    <HeadingBlock {...POPULAR_TITLE} client:idle />

    <div class="grid md:grid-cols-[1fr_1.4fr] gap-6 md:gap-4 lg:gap-10">

      {popularPosts.length > 0 && (
        <BlogCard
          {...popularPosts[0]}
          className="md:max-h-blog-sm lg:max-h-blog-md xl:max-h-blog-lg"
          titleClassName="h-full"
          client:load
        />
      )}

      <div class="flex flex-col gap-6 md:gap-2 justify-between">
        {popularPosts.slice(1, 3).map((post) => (
          <BlogCard {...post} variant="horizontal" client:load />
        ))}
      </div>
    </div>
  </section>

  <!-- TRENDING POSTS -->
  <TrendingPosts posts={trendingPosts} postsPerPage={6} client:load />
</PageLayout>
