---
import PageLayout from '@/layouts/PageLayout.astro';
import { Hero } from '@/components';
import {PopularPosts, HeadingBlock, TrendingPosts} from '@/sections'
import type { HomePageType } from '@/types/home';
import { homePageQuery } from '@/queries/homePage';
import { loadQuery } from '@/sanity/load-query';

let homePage: HomePageType | null = null;

try {
  const { data } = await loadQuery<HomePageType>({ query: homePageQuery });
  homePage = data;
} catch {
  throw new Error('Internal Server Error');
}

if (!homePage) throw new Error('Not Found');

const { heroPost, popularPosts, trendingPosts } = homePage;
---

<PageLayout>
  <Hero {...heroPost} />

  <section class="container mx-auto mb-16 md:mb-24">
    <HeadingBlock heading={popularPosts.heading} />
    <PopularPosts posts={popularPosts.posts} />
  </section>

  <section class="container mx-auto flex flex-col mb-20">
    <HeadingBlock heading={trendingPosts.heading} />
    <TrendingPosts posts={trendingPosts.posts} />
  </section>
</PageLayout>
