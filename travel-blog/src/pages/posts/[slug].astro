---
// Layouts
import PageLayout from '@/layouts/PageLayout.astro'
import { postDetailQuery, postSlugsQuery, socialsQuery } from '@/queries/detailPage';
import { loadQuery } from '@/sanity/load-query';

// Sections
import { DetailHeader, DetailSidebar, DetailContent} from '@/sections'
import type { PostDetailType, SocialIconType } from '@/types/detail';


// Static paths
export async function getStaticPaths() {
  const { data } = await loadQuery<{ slug: string }[]>({
    query: postSlugsQuery,
  });

  return data.map((post) => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;

// --- Fetch post detail
let post: PostDetailType | null = null;
try {
  const { data } = await loadQuery<PostDetailType>({
    query: postDetailQuery,
    params: { slug },
  });
  post = data;
} catch {
  throw new Error('Failed to fetch post');
}

if (!post) {
  throw new Error(`Post with slug "${slug}" not found`);
}

// --- Fetch socials
let socials: SocialIconType[] = [];
try {
  const { data } = await loadQuery<SocialIconType[]>({
    query: socialsQuery,
  });
  socials = data;
} catch {
  console.error('Failed to fetch socials');
}

---

<PageLayout>
  <article class="max-w-3xl mx-auto py-8">
    <!-- Header -->
    <DetailHeader title={post.title} author={post.author} />

    <!-- Main body -->
    <div class="lg:relative">
      <!-- Social icons -->
      <DetailSidebar socials={socials} />

      <DetailContent image={post.image} excerpt={post.excerpt} content={post.content} />
    </div>
  </article>
</PageLayout>
