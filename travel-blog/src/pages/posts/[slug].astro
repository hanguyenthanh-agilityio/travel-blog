---
// Layouts
import PageLayout from '@/layouts/PageLayout.astro'

// Sections
import { DetailHeader, DetailSidebar, DetailContent} from '@/sections'

// Libs
import {fetchPostBySlug, fetchPosts, getSocials} from '@/lib/api'

// Static paths
export async function getStaticPaths() {
  const posts = await fetchPosts()

  return posts.map((post) => ({
    params: {
      slug: typeof post.slug === 'string' ? post.slug : post.slug?.current || '',
    },
  }))
}

const  socials  = await getSocials();

// Fetch single post
const {slug} = Astro.params
const post = await fetchPostBySlug(slug)

// Handle not found
if (!post) throw new Error(`Post with slug "${slug}" not found`)

---

<PageLayout>
  <article class="max-w-3xl mx-auto py-8">
    <!-- Header -->
    <DetailHeader title={post.title} author={post.author} />

    <!-- Main body -->
    <div class="lg:relative">
      <!-- Social icons -->
      <DetailSidebar socials={socials} />

      <DetailContent image={post.image} excerpt={post.excerpt} content={post.content} />
    </div>
  </article>
</PageLayout>
