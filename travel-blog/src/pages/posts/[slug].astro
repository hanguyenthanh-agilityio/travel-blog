---
// Layouts
import PageLayout from '@/layouts/PageLayout.astro';

// Sanity
import { loadQuery } from '@/sanity/load-query';

// Queries
import {
  postDetailQuery,
  postSlugsQuery,
  socialsQuery,
} from '@/queries/detailPage';

// Sections
import { ArticleBody, ArticleHeader, ArticleSidebar } from '@/sections';

// Types
import type { PostDetailType, SocialIconType } from '@/types/detail';

// Static paths
export async function getStaticPaths() {
  const { data } = await loadQuery<{ slug: string | { current: string } }[]>({
    query: postSlugsQuery,
  });

  return data.map((post) => ({
    params: {
      slug: typeof post.slug === 'string' ? post.slug : post.slug.current,
    },
  }));
}

// --- Params
const { slug: rawSlug } = Astro.params as {
  slug: string | { current: string };
};

const slug = typeof rawSlug === 'string' ? rawSlug : rawSlug?.current;

if (!slug) {
  throw new Error('Invalid slug parameter');
}

// --- Fetch post detail
let post: PostDetailType | null = null;
try {
  const { data } = await loadQuery<PostDetailType>({
    query: postDetailQuery,
    params: { slug },
  });
  post = data;
} catch {
  throw new Error('Failed to fetch post');
}

if (!post) {
  throw new Error(`Post with slug "${slug}" not found`);
}

// --- Fetch socials
let socials: SocialIconType[] = [];
try {
  const { data } = await loadQuery<SocialIconType[]>({
    query: socialsQuery,
  });
  socials = data;
} catch {
  socials = [];
}

const { title, author, image, excerpt, content } = post;
---

<PageLayout>
  <article class="max-w-3xl mx-auto py-8">
    <!-- Header -->
    <ArticleHeader title={title} author={author} />

    <!-- Main body -->
    <div class="lg:relative">
      <!-- Social icons -->
      <ArticleSidebar socials={socials} />

      <ArticleBody image={image} excerpt={excerpt} content={content} />
    </div>
  </article>
</PageLayout>
