---
import { AuthorCard, LazyImage } from '@/components';
import Link from '@/components/ui/link';
import { cn } from '@/lib/utils';

const {
  slug,
  title,
  image,
  author,
  variant = 'default',
  className,
} = Astro.props;

const isHorizontal = variant === 'horizontal';
---

<Link href={`/posts/${slug}`}>
  <div
    class={cn(
      'overflow-hidden rounded-xl bg-transparent transition-transform duration-300 ease-in-out hover:shadow-lg hover:-translate-y-1 hover:scale-[1.01]',
      isHorizontal ? 'flex flex-col md:flex-row gap-4' : 'flex flex-col',
    )}
  >
    <!-- Image -->
    <LazyImage
      src={image}
      alt={title}
      class={cn(
        'object-cover rounded-xl',
        isHorizontal ? 'w-full md:w-1/2 max-h-blog-md' : 'w-full',
        className,
      )}
      loading="lazy"
      decoding="async"
    />

    <!-- Content -->
    <div
      class={cn(
        'px-2',
        isHorizontal ? 'flex-1 py-4 flex flex-col justify-between' : 'py-4',
      )}
    >
      <h3 class="text-lg md:text-xl font-bold mb-4 line-clamp-2">
        {title}
      </h3>
      <AuthorCard {...author} classAvatar="w-10 h-10" client:load />
    </div>
  </div>
</Link>
